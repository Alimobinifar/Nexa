@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable



<div class="layout-wrapper" dir="rtl">

    <!-- دکمه باز کردن منو در موبایل -->
    <button type="button"
            class="mobile-menu-btn"
            @onclick="OpenMobileMenu">
        ☰
    </button>

    <!-- پس زمینه تاریک موبایل -->
    @if (IsMobileMenuOpen)
    {
        <div class="sidebar-overlay"
             @onclick="CloseMobileMenu">
        </div>
    }

    <!-- سایدبار -->
    <aside class="sidebar
        @(IsCollapsed ? "collapsed" : "")
        @(IsMobileMenuOpen ? "mobile-open" : "")">

        <!-- هدر -->
        <div class="sidebar-header">

            <div class="brand">
                <div class="brand-icon">📦</div>

                @if (!IsCollapsed)
                {
                    <span class="brand-text">سیستم مدیریت فروشگاه نکسا</span>
                }
            </div>

            <button type="button"
                    class="toggle-btn"
                    @onclick="ToggleSidebar"
                    title="باز و بسته کردن منو">
                ☰
            </button>

            <!-- دکمه بستن موبایل -->
            <button type="button"
                    class="mobile-close-btn"
                    @onclick="CloseMobileMenu">
                ✕
            </button>

        </div>

        <!-- منوی اصلی -->
        <nav class="sidebar-menu">

            <ul>

                <!-- داشبورد -->
                <li>
                    <NavLink href="/"
                             Match="NavLinkMatch.All"
                             class="menu-link">
                        <span class="icon">🏠</span>
                        <span class="text">داشبورد</span>
                    </NavLink>
                </li>

                <!-- موجودی -->
                <li class="has-children @(IsInventoryOpen ? "open" : "")">

                    <div class="menu-link parent"
                         @onclick="ToggleInventory">

                        <span class="icon">📦</span>
                        <span class="text">مدیریت محصولات</span>
                        <span class="arrow">▾</span>

                    </div>

                    <ul class="submenu">
                        <li>
                            <NavLink href="/Products/Create" class="menu-link">
                                اضافه کردن محصول جدید
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/Products/List" class="menu-link">
                                لیست محصولات
                            </NavLink>
                        </li>

                    </ul>

                </li>

                <!-- انبارها -->
                <li class="has-children @(IsWarehousesOpen ? "open" : "")">

                    <div class="menu-link parent"
                         @onclick="ToggleWarehouses">

                        <span class="icon">🏭</span>
                        <span class="text">انبارها</span>
                        <span class="arrow">▾</span>

                    </div>

                    <ul class="submenu">

                        <li>
                            <NavLink href="/warehouses/entry" class="menu-link">
                                ثبت ورود کالا
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/warehouses/exit" class="menu-link">
                                ثبت خروج کالا
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/warehouses/inventory" class="menu-link">
                                موجودی انبار
                            </NavLink>
                        </li>

                    </ul>

                </li>

                <!-- تأمین‌کنندگان -->
                <li class="has-children @(IsSuppliersOpen ? "open" : "")">

                    <div class="menu-link parent"
                         @onclick="ToggleSuppliers">

                        <span class="icon">🤝</span>
                        <span class="text">مدیریت تامین کنندگان</span>
                        <span class="arrow">▾</span>

                    </div>

                    <ul class="submenu">

                        <li>
                            <NavLink href="/suppliers/create" class="menu-link">
                                اضافه کردن تامین کننده
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/suppliers/list" class="menu-link">
                                لیست تامین کنندگان
                            </NavLink>
                        </li>

                    </ul>

                </li>

                <li class="has-children @(IsSaleChannelsOpen ? "open" : "")">

                    <div class="menu-link parent"
                         @onclick="ToggleSaleChannels">

                        <span class="icon">🏭</span>
                        <span class="text">کانال های فروش</span>
                        <span class="arrow">▾</span>

                    </div>

                    <ul class="submenu">

                        <li>
                            <NavLink href="/warehouses/entry" class="menu-link">
                                ثبت کانال فروش 
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/warehouses/exit" class="menu-link">
                               لیست کانال های فروش 
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/warehouses/inventory" class="menu-link">
                                تنظیمات کانال ها
                            </NavLink>
                        </li>

                    </ul>

                </li>



                <!-- سفارشات خرید -->
                <li class="has-children @(IsOrdersOpen ? "open" : "")">

                    <div class="menu-link parent"
                         @onclick="ToggleOrders">

                        <span class="icon">🛒</span>
                        <span class="text"> مدیریت فروش و هزینه</span>
                        <span class="arrow">▾</span>

                    </div>

                    <ul class="submenu">
                        <li>
                            <NavLink href="/orders/list" class="menu-link">
                                فروش ها (فاکتور ها )
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/orders/new" class="menu-link">
                                ثبت فاکتور فروش جدید
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/orders/pending" class="menu-link">
                               ثبت پیش فاکتور 
                            </NavLink>
                        </li>
                        <li>
                            <NavLink href="/orders/pending" class="menu-link">
                              ثبت هزینه
                            </NavLink>
                        </li>
                    </ul>

                </li>

                <!-- گزارش‌ها -->
                <li class="has-children @(IsReportsOpen ? "open" : "")">

                    <div class="menu-link parent"
                         @onclick="ToggleReports">

                        <span class="icon">📊</span>
                        <span class="text">گزارش‌ها</span>
                        <span class="arrow">▾</span>

                    </div>

                    <ul class="submenu">
                        <li>
                            <NavLink href="/reports/sales" class="menu-link">
                                فروش 
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/reports/inventory" class="menu-link">
                                موجودی کالا ها و انبار
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/reports/financial" class="menu-link">
                                صورت سود و زیان 
                            </NavLink>
                        </li>
                    </ul>

                </li>

                <!-- مشتریان -->
                <li class="has-children @(IsCustomersOpen ? "open" : "")">

                    <div class="menu-link parent"
                         @onclick="ToggleCustomers">

                        <span class="icon">👥</span>
                        <span class="text">مشتریان</span>
                        <span class="arrow">▾</span>

                    </div>

                    <ul class="submenu">

                        <li>
                            <NavLink href="/customers/create" class="menu-link">
                                ثبت مشتری جدید
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/customers/list" class="menu-link">
                                لیست مشتریان
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/customers/club" class="menu-link">
                                باشگاه مشتریان
                            </NavLink>
                        </li>

                    </ul>

                </li>

                <li>
                    <NavLink href="/logout" class="menu-link">
                        <span class="icon">🚪</span>
                        <span class="text">خروج</span>
                    </NavLink>
                </li>

            </ul>

        </nav>

        <!-- اطلاعات کاربر -->
        <div class="sidebar-footer">

            <div class="user-card">

                <div class="avatar">ر</div>

                @if (!IsCollapsed)
                {
                    <div class="user-info">
                        <div class="name">علی مبینی فر</div>
                        <div class="role">مدیر سیستم</div>
                    </div>
                }

            </div>

        </div>

    </aside>

    <!-- محتوای اصلی -->
    <main class="main @(IsCollapsed ? "expanded" : "")">

        <div class="main-inner">
            @Body
        </div>

    </main>

</div>

@code {

    private bool IsCollapsed = false;

    private bool IsMobileMenuOpen = false;

    private bool IsInventoryOpen = false;

    private bool IsOrdersOpen = false;

    private bool IsReportsOpen = false;

    private bool IsSuppliersOpen = false;

    private bool IsCustomersOpen = false;

    private bool IsWarehousesOpen = false;

    private bool IsSaleChannelsOpen = false;


    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;

        UpdateOpenMenu(Navigation.Uri);
    }

    private void OnLocationChanged(
        object? sender,
        Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(() =>
        {
            UpdateOpenMenu(e.Location);
            StateHasChanged();
        });
    }

    private void UpdateOpenMenu(string url)
    {
        var path = Navigation.ToBaseRelativePath(url)
            .Split('?')[0]
            .Split('#')[0]
            .Trim('/');

        IsInventoryOpen = path.StartsWith(
            "Products", StringComparison.OrdinalIgnoreCase);

        IsWarehousesOpen = path.StartsWith(
            "warehouses", StringComparison.OrdinalIgnoreCase);

        IsSuppliersOpen = path.StartsWith(
            "suppliers", StringComparison.OrdinalIgnoreCase);

        IsSaleChannelsOpen = path.StartsWith(
            "sales-channels", StringComparison.OrdinalIgnoreCase);

        IsOrdersOpen = path.StartsWith(
            "orders", StringComparison.OrdinalIgnoreCase);

        IsReportsOpen = path.StartsWith(
            "reports", StringComparison.OrdinalIgnoreCase);

        IsCustomersOpen = path.StartsWith(
            "customers", StringComparison.OrdinalIgnoreCase);
    }
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }


    // جمع و باز کردن منو در دسکتاپ
    private void ToggleSidebar()
    {
        IsCollapsed = !IsCollapsed;

        if (IsCollapsed)
        {
            IsInventoryOpen = false;
            IsOrdersOpen = false;
            IsReportsOpen = false;
            IsSuppliersOpen = false;
            IsCustomersOpen = false;
            IsWarehousesOpen = false;
            IsSaleChannelsOpen = false;
        }
    }


    // باز کردن منوی موبایل
    private void OpenMobileMenu()
    {
        IsMobileMenuOpen = true;
    }


    // بستن منوی موبایل
    private void CloseMobileMenu()
    {
        IsMobileMenuOpen = false;
    }


    // زیرمنوی موجودی
    private void ToggleInventory()
    {
        IsInventoryOpen = !IsInventoryOpen;
    }


    private void ToggleSuppliers()
    {
        IsSuppliersOpen = !IsSuppliersOpen;
    }


    // زیرمنوی سفارشات
    private void ToggleOrders()
    {
        IsOrdersOpen = !IsOrdersOpen;
    }


    // زیرمنوی گزارش‌ها
    private void ToggleReports()
    {
        IsReportsOpen = !IsReportsOpen;
    }

    // زیرمنوی گزارش‌ها
    private void ToggleCustomers()
    {
        IsCustomersOpen = !IsCustomersOpen;
    }

    private void ToggleWarehouses()
    {
        IsWarehousesOpen = !IsWarehousesOpen;
    }

    private void ToggleSaleChannels()
    {
        IsSaleChannelsOpen = !IsSaleChannelsOpen;
    }

}
